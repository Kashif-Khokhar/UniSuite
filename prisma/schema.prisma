generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  
  students    Student[]
  teachers    Teacher[]
  courses     Course[]
}

model Student {
  id                String       @id @default(cuid())
  name              String
  fatherName        String?
  rollNumber        String       @unique
  email             String       @unique
  password          String
  program           String
  
  departmentId      String?
  department        Department?  @relation(fields: [departmentId], references: [id])
  
  faculty           String?
  career            String?
  currentSemester   Int          @default(1)
  cgpa              Float        @default(0)
  dob               DateTime?
  gender            String?
  cnic              String?
  domicile          String?
  nationality       String?
  religion          String?
  bloodGroup        String?
  fatherCnic        String?
  maritalStatus     String?
  contact           String?
  emergencyContact  String?
  presentAddress    String?
  permanentAddress  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  enrollments       Enrollment[]
  feeChallans       FeeChallan[]
  requests          StudentRequest[]
  hostelAllocation  HostelAllocation?
}

model Teacher {
  id            String    @id @default(cuid())
  employeeId    String    @unique
  email         String    @unique
  password      String
  name          String
  
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  mobile        String?
  nationality   String?
  institute     String?
  joiningDate   DateTime?
  status        String    @default("Active") // Active | Inactive
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sections      Section[]
}

model Course {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  creditHours   Int
  
  departmentId  String?
  department    Department?   @relation(fields: [departmentId], references: [id])

  sections      Section[]
}

model Section {
  id            String        @id @default(cuid())
  name          String        // e.g. "Section A", "BSCS-6A"
  courseId      String
  teacherId     String?
  
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher       Teacher?      @relation(fields: [teacherId], references: [id])
  
  enrollments   Enrollment[]
  makeupClasses MakeupClass[]
  schedules     ClassSchedule[]

  @@unique([courseId, name])
}

model Enrollment {
  id         String       @id @default(cuid())
  studentId  String
  sectionId  String
  semester   Int
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section    Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  attendance Attendance[]
  grade      Grade?

  @@unique([studentId, sectionId])
}

model Attendance {
  id           String     @id @default(cuid())
  enrollmentId String
  date         DateTime
  status       String // Present | Absent | Leave
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model Grade {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  midterm      Float      @default(0)
  final        Float      @default(0)
  sessional    Float      @default(0)
  total        Float      @default(0)
  gradeLetter  String?
  gpa          Float      @default(0)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model FeeChallan {
  id           String   @id @default(cuid())
  studentId    String
  amount       Float
  dueDate      DateTime
  status       String // Paid | Unpaid
  billingMonth String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model MakeupClass {
  id        String   @id @default(cuid())
  term      String
  sectionId String
  date      DateTime
  fromTime  String
  toTime    String
  createdAt DateTime @default(now())

  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model ClassSchedule {
  id        String   @id @default(cuid())
  sectionId String
  dayOfWeek String   // Monday, Tuesday, etc.
  startTime String   // e.g., "09:00 AM"
  endTime   String   // e.g., "10:30 AM"
  room      String?

  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model StudentRequest {
  id          String   @id @default(cuid())
  studentId   String
  type        String   // e.g., Transcript, Leave, Re-test
  description String?
  status      String   @default("Pending") // Pending | Approved | Rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  target    String   // All, Student, Teacher, specific ID
  createdAt DateTime @default(now())
}

model HostelRoom {
  id          String   @id @default(cuid())
  roomNumber  String   @unique
  capacity    Int
  available   Int
  
  allocations HostelAllocation[]
}

model HostelAllocation {
  id          String   @id @default(cuid())
  studentId   String   @unique
  roomId      String
  allocatedAt DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room        HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
